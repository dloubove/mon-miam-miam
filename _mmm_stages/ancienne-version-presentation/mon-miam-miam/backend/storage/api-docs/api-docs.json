        "/auth/inscription": {
            "post": {
                "tags": [
                    "Authentification"
                ],
                "summary": "Créer un compte étudiant",
                "description": "Crée un compte immédiatement utilisable, sans confirmation de l’adresse email.",
                "operationId": "b14cee8fff29c70d113cabc834895abc",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object"
                            },
                            "example": {
                                "nom": "Dan Loubove",
                                "email": "dan@example.cm",
                                "telephone": "699000000",
                                "mot_de_passe": "Secret1234",
                                "localisation": "Campus"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Compte créé"
                    },
                    "422": {
                        "description": "Données invalides"
                    }
                }
            }
        },
        "/auth/connexion": {
            "post": {
                "tags": [
                    "Authentification"
                ],
                "summary": "Ouvrir une session API",
                "description": "Retourne utilisateur, jeton Bearer Sanctum et date d’expiration (1 jour, ou 30 jours si se_souvenir=true). Une notification email est envoyée après la connexion si le service mail est configuré; l’adresse n’a pas à être confirmée.",
                "operationId": "63febe3348209578af3c72962803494f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object"
                            },
                            "example": {
                                "email": "dan@example.cm",
                                "mot_de_passe": "Secret1234",
                                "se_souvenir": false
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Connexion réussie"
                    },
                    "422": {
                        "description": "Identifiants incorrects"
                    }
                }
            }
        },
