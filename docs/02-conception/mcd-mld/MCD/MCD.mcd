%% MCD - Mon Miam Miam (ZeDuc@Space)
:
JETON_MDP: _id_jeton [INT], jeton_hash [VARCHAR(255)], date_expiration_jeton [DATETIME], jeton_utilise [BOOLEAN]
RECUPERER, 11 JETON_MDP, 0N UTILISATEUR
UTILISATEUR: _id_utilisateur [INT], nom [VARCHAR(100)], email [VARCHAR(150)], mot_de_passe [VARCHAR(255)], telephone [VARCHAR(20)], date_inscription [DATETIME], statut_compte [VARCHAR(10)]
DONNER, 11 CONSENTEMENT, 0N UTILISATEUR
CONSENTEMENT: _id_consentement [INT], finalite [VARCHAR(50)], consentement_accorde [BOOLEAN], date_consentement [DATETIME]
:
:

:
CREER_COMPTE, 0N PERSONNEL, 01 PERSONNEL: date_creation_compte [DATETIME]
:
/XT\ UTILISATEUR <- ETUDIANT, PERSONNEL
:
PARRAINER, 0N ETUDIANT, 01 ETUDIANT: date_parrainage [DATETIME], recompense_attribuee [BOOLEAN], points_parrainage [INT]
JOUER, 0N ETUDIANT, 0N MINI_JEU: date_partie [DATETIME], score_partie [INT], points_remportes [INT]
MINI_JEU: _id_mini_jeu [INT], nom_mini_jeu [VARCHAR(100)], description_mini_jeu [TEXT], points_maximum [INT], statut_mini_jeu [VARCHAR(10)], affiche_mini_jeu [VARCHAR(255)]

ROLE: _id_role [INT], libelle_role [VARCHAR(30)]
AVOIR_ROLE, 11 PERSONNEL, 0N ROLE
PERSONNEL: matricule [VARCHAR(20)], date_embauche [DATE]
:
:
ETUDIANT: code_parrainage [VARCHAR(20)], solde_points [INT], localisation [VARCHAR(255)]
PARTICIPER, 0N ETUDIANT, 0N EVENEMENT: date_participation [DATETIME], score [INT], points_gagnes [INT]
EVENEMENT: _id_evenement [INT], titre_evenement [VARCHAR(150)], type_evenement [VARCHAR(20)], description_evenement [TEXT], date_debut_evenement [DATETIME], date_fin_evenement [DATETIME], points_recompense [INT], affiche_evenement [VARCHAR(255)]

EMPLOYER, 01 PERSONNEL, 0N RESTAURANT
VALIDER, 01 COMMANDE, 0N PERSONNEL: date_validation [DATETIME]
REPONDRE, 01 RECLAMATION, 0N PERSONNEL: reponse_proposee [TEXT], date_reponse [DATETIME]
DECIDER, 01 RECLAMATION, 0N PERSONNEL: decision_gerant [VARCHAR(10)], motif_decision [TEXT], date_decision [DATETIME]
DEPOSER, 11 RECLAMATION, 0N ETUDIANT
:
CUMULER, 11 MOUVEMENT_POINTS, 0N ETUDIANT
:

:
:
:
RECLAMATION: _id_reclamation [INT], objet [VARCHAR(150)], description_reclamation [TEXT], date_reclamation [DATETIME], statut_reclamation [VARCHAR(20)]
:
PASSER, 0N ETUDIANT, 11 COMMANDE
MOUVEMENT_POINTS: _id_mouvement [INT], type_mouvement [VARCHAR(30)], nombre_points [INT], date_mouvement [DATETIME], date_expiration_points [DATE]
:

:
:
:
CONCERNER, 01 RECLAMATION, 0N COMMANDE
:
GENERER, 01 MOUVEMENT_POINTS, 0N COMMANDE
:
:

:
RESTAURANT: _id_restaurant [INT], nom_restaurant [VARCHAR(100)], adresse_restaurant [VARCHAR(255)], telephone_restaurant [VARCHAR(20)]
RECEVOIR, 11 COMMANDE, 0N RESTAURANT
COMMANDE: _id_commande [INT], date_commande [DATETIME], statut_commande [VARCHAR(20)], mode_service [VARCHAR(15)], heure_arrivee [TIME], adresse_livraison [VARCHAR(255)], montant_total [DECIMAL(10,0)], points_utilises [INT], reduction_points [DECIMAL(10,0)], points_gagnes [INT], commentaire_client [TEXT], date_commentaire [DATETIME]
REGLER, 11 PAIEMENT, 0N COMMANDE
PAIEMENT: _id_paiement [INT], montant_paye [DECIMAL(10,0)], mode_paiement [VARCHAR(20)], reference_transaction [VARCHAR(100)], statut_paiement [VARCHAR(20)], date_paiement [DATETIME]
:
:

CONFIGURER, 11 PARAMETRE, 0N RESTAURANT
PUBLIER, 11 MENU_JOUR, 0N RESTAURANT
PROPOSER, 11 ARTICLE, 0N RESTAURANT
CONTENIR, 1N COMMANDE, 0N ARTICLE: quantite [INT], prix_applique [DECIMAL(10,0)]
:
APPLIQUER, 01 COMMANDE, 0N PROMOTION
PROMOTION: _id_promotion [INT], titre_promotion [VARCHAR(150)], description_promotion [TEXT], taux_reduction [DECIMAL(5,2)], date_debut_promo [DATE], date_fin_promo [DATE], affiche_promo [VARCHAR(255)]
:

PARAMETRE: _id_parametre [INT], cle_parametre [VARCHAR(60)], valeur_parametre [VARCHAR(255)], description_parametre [VARCHAR(255)]
MENU_JOUR: _id_menu_jour [INT], date_menu [DATE]
COMPOSER, 1N MENU_JOUR, 0N ARTICLE
ARTICLE: _id_article [INT], nom_article [VARCHAR(100)], description_article [TEXT], prix_unitaire [DECIMAL(10,0)], image_article [VARCHAR(255)], disponible [BOOLEAN]
APPARTENIR, 11 ARTICLE, 0N CATEGORIE
CATEGORIE: _id_categorie [INT], libelle_categorie [VARCHAR(50)]
:
:
